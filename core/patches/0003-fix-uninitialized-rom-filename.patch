 src/LIBRETRO/libretro.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/LIBRETRO/libretro.c b/src/LIBRETRO/libretro.c
index 482eb67..d8195a1 100644
--- a/src/LIBRETRO/libretro.c
+++ b/src/LIBRETRO/libretro.c
@@ -452,6 +452,11 @@ static bool load_system_file(uint8_t bios_index, byte *rom_data, uint32_t rom_si
 
       strncpy(filename, bios_filenames[bios_index][i], sizeof(filename) - 1);
 
+      /* rom_filename はループの外で一度も書かれない場合があるため、
+       * 未初期化のまま filestream_exists() に渡ってしまう不具合を修正する。
+       * 毎回のイテレーション先頭で空文字に初期化する。 */
+      rom_filename[0] = '\0';
+
       /* Look in the download directory first... */
       if (!filestream_exists(rom_filename) && !string_is_empty(download_dir))
          snprintf(rom_filename, sizeof(rom_filename), "%s%c%s", download_dir, SLASH, filename);
