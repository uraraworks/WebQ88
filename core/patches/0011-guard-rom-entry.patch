+extern z80arch z80main_cpu;
+extern int webq88_guard_enabled, webq88_guard_stopped;
+extern int webq88_guard_rom_mapped, webq88_guard_previous_ram;
+extern unsigned int webq88_guard_source, webq88_guard_opcode;
