---
 src/LIBRETRO/libretro.c | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/src/LIBRETRO/libretro.c b/src/LIBRETRO/libretro.c
index 7b76cbe..482eb67 100644
--- a/src/LIBRETRO/libretro.c
+++ b/src/LIBRETRO/libretro.c
@@ -26,7 +26,6 @@
 #include "fdc.h"
 #include "soundbd.h"
 #include "pc88cpu.h"
-#include "pseudo_bios.h"
 #include "disks.h"
 #include "libretro_core_options.h"
 static bool libretro_supports_option_categories = false;
@@ -546,11 +545,21 @@ void retro_init(void)
 
    memory_allocate();
 
-   /* Fallback on pseudo BIOS if needed */
+   /* pseudo_bios.h（出所不明の疑似BIOS）は参照しない。
+    * N88.ROM / DISK.ROM が無ければ 0 埋めにし、利用側が
+    * 互換ROMか公式ROMを system directory に置く前提とする。 */
    if (!load_system_file(N88_ROM, main_rom,   0x08000))
-      memcpy(main_rom, &pbios_n88, 0x08000);
+   {
+      memset(main_rom, 0, 0x08000);
+      if (log_cb)
+         log_cb(RETRO_LOG_ERROR, "[QUASI88]: N88.ROM が見つかりません\n");
+   }
    if (!load_system_file(SUB_ROM, sub_romram, 0x00800))
-      memcpy(sub_romram, &pbios_disk, 0x00800);
+   {
+      memset(sub_romram, 0, 0x00800);
+      if (log_cb)
+         log_cb(RETRO_LOG_ERROR, "[QUASI88]: DISK.ROM が見つかりません\n");
+   }
    rom_version = ROM_VERSION;
    load_system_file(EXT0_ROM,  main_rom_ext[0], 0x02000);
    load_system_file(EXT1_ROM,  main_rom_ext[1], 0x02000);
