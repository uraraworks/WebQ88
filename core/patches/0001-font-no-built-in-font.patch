 2 files changed, 24 insertions(+), 24 deletions(-)

diff --git a/src/LIBRETRO/libretro.c b/src/LIBRETRO/libretro.c
index f77a7a5..7b76cbe 100644
--- a/src/LIBRETRO/libretro.c
+++ b/src/LIBRETRO/libretro.c
@@ -15,7 +15,6 @@
 #include "pc88main.h"
 #include "pc88sub.h"
 #include "memory.h"
-#include "font.h"
 #include "emu.h"
 #include "drive.h"
 #include "event.h"
@@ -496,6 +495,7 @@ static bool load_system_file(uint8_t bios_index, byte *rom_data, uint32_t rom_si
 void retro_init(void)
 {
    char *dir = NULL;
+   bool knj1_loaded = false;
    struct retro_rumble_interface rumble;
 
    struct retro_input_descriptor desc[] = {
@@ -557,38 +557,39 @@ void retro_init(void)
    load_system_file(EXT2_ROM,  main_rom_ext[2], 0x02000);
    load_system_file(EXT3_ROM,  main_rom_ext[3], 0x02000);
    load_system_file(N_ROM,     main_rom_n,      0x08000);
-   load_system_file(KNJ1_ROM,  kanji_rom[0][0], 0x20000);
+   knj1_loaded = load_system_file(KNJ1_ROM,  kanji_rom[0][0], 0x20000);
    load_system_file(KNJ2_ROM,  kanji_rom[1][0], 0x20000);
    load_system_file(JISHO_ROM, jisho_rom[0],    0x80000);
 
    /* == Font files == */
-   /* Font 1 */
+   /* Font 1: ロード成功時は font_mem を一切上書きしない。
+    *         失敗時は built_in_font_* ではなく 0 埋め。
+    *         ANK を漢字ROMから取るのは KNJ1_ROM の読み込みが
+    *         実際に成功したときだけとする。 */
    if (load_system_file(FONT_ROM, font_mem, 0x01000))
    {
       font_loaded |= 1;
+   }
+   else if (knj1_loaded)
+   {
       memcpy(&font_mem[0x000], &kanji_rom[0][(1<<11)][0], 0x800);
-      memcpy(&font_mem[0x800], &built_in_font_graph[0],   0x800);
+      memset(&font_mem[0x800], 0, 0x800);
    }
    else
-      memcpy(&font_mem[0x000], &built_in_font_ANK[0],     0x800);
+      memset(&font_mem[0x000], 0, 0x1000);
 
    /* Font 2 */
    if (load_system_file(FONT2_ROM, font_mem2, 0x01000))
    {
       font_loaded |= 2;
-      memcpy(&font_mem2[0x000], &built_in_font_ANH[0],    0x800);
    }
    else
-   {
-      memcpy(&font_mem2[0x000], &built_in_font_ANH[0],    0x800);
-      memcpy(&font_mem2[0x800], &built_in_font_graph[0],  0x800);
-   }
+      memset(&font_mem2[0x000], 0, 0x1000);
 
    /* Font 3 */
    if (load_system_file(FONT3_ROM, font_mem3, 0x01000))
    {
       font_loaded |= 4;
-      memcpy(&font_mem3[0x800], &built_in_font_graph[0],  0x800);
    }
    else
       memset(&font_mem3[0], 0, 0x1000);
