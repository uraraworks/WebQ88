       if( has_kanji_rom ){
 	memcpy( &font_mem[0], &kanji_rom[0][(1<<11)][0], 0x100*8 );
       }else{
-	memcpy( &font_mem[0], &built_in_font_ANK[0], 0x100*8 );
+	memset( &font_mem[0], 0, 0x100*8 );
 	font_loaded &= ~1;
       }
     }
   }
 
