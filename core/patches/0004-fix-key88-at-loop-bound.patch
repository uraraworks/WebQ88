src/keyboard.h では KEY88_AT = 64、libretro-common の RETROK_AT も 64 で
値が一致するにもかかわらず、handle_input() の
'for (i = 0; i < 64; i++) handle_key(i, i);' は i<64 のため 64 を含まず、
KEY88_AT はどこからも handle_key() されない。結果として '@' キーがホストから
PC-88へ一切届かなかった。ループ上限を KEY88_AT を含む形に変更する。
---
 src/LIBRETRO/libretro.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/LIBRETRO/libretro.c b/src/LIBRETRO/libretro.c
index d8195a1..1ea585b 100644
--- a/src/LIBRETRO/libretro.c
+++ b/src/LIBRETRO/libretro.c
@@ -235,7 +235,10 @@ static void handle_input(void)
    handle_pad(KEY88_Q,      RETRO_DEVICE_ID_JOYPAD_B,      1);
    
    /* Basics, numbers */
-   for (i = 0; i < 64; i++)
+   /* KEY88_AT (== RETROK_AT == 64) はこのループの外側にあり、
+    * 「i < 64」では取りこぼされて '@' キーが一切反応しない不具合があった。
+    * KEY88_AT を含むよう上限を <= に変更して修正する。 */
+   for (i = 0; i <= KEY88_AT; i++)
       handle_key(i, i);
    for (i = 0; i < 6; i++)
       handle_key(KEY88_BRACKETLEFT + i, RETROK_LEFTBRACKET + i);
